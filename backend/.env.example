# Panther TMS Backend Environment Configuration
ENVIRONMENT=production
PROJECT_NAME=PantherTMS
API_V1_PREFIX=/api/v1
BASE_DOMAIN=panthertms.com

# Database (PostgreSQL)
POSTGRES_USER=panther
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
CONTROL_DB_NAME=panther_control

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Security
SECRET_KEY=generate_a_random_32_character_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# GSP / E-Way Bill Integration (Dokploy Environment)
GSP_BASE_URL=https://gsp.adaequare.com
GSP_CLIENT_ID=your_gsp_app_client_id_here
GSP_CLIENT_SECRET=your_gsp_app_client_secret_here

# Freight Tiger SIM Tracking Integration (https://freight-tiger.readme.io/reference)
# Sandbox server: https://integration.freighttiger.com
# Production server: https://www.freighttiger.com
FREIGHT_TIGER_BASE_URL=https://integration.freighttiger.com
FREIGHT_TIGER_AUTH_TOKEN=your_freight_tiger_jwt_bearer_token_here
FREIGHT_TIGER_COMPANY_ID=your_freight_tiger_company_id_here

# Razorpay Subscription & Billing Integration
RAZORPAY_KEY_ID=rzp_test_panther_tms
RAZORPAY_KEY_SECRET=rzp_secret_panther_tms_secure
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_panther_2026

