# Panther TMS Backend Environment Configuration
ENVIRONMENT=production
PROJECT_NAME=PantherTMS
API_V1_PREFIX=/api/v1
BASE_DOMAIN=panthertms.com

# Database (PostgreSQL)
POSTGRES_USER=panther
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
CONTROL_DB_NAME=panther_control

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Security
SECRET_KEY=generate_a_random_32_character_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# GSP / E-Way Bill Integration (Dokploy Environment)
GSP_BASE_URL=https://gsp.adaequare.com
GSP_CLIENT_ID=your_gsp_app_client_id_here
GSP_CLIENT_SECRET=your_gsp_app_client_secret_here

# Freight Tiger SIM Tracking Integration (https://freight-tiger.readme.io/reference)
# Tether API: https://api.freighttiger.com/api/tether
FREIGHT_TIGER_BASE_URL=https://api.freighttiger.com/api/tether
FREIGHT_TIGER_AUTH_TOKEN=your_freight_tiger_jwt_bearer_token_here

# Razorpay Subscription & Billing Integration
RAZORPAY_KEY_ID=rzp_test_panther_tms
RAZORPAY_KEY_SECRET=rzp_secret_panther_tms_secure
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_panther_2026

# Panther AI Assistant - LLM Provider Configuration
AI_PROVIDER=groq
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.8-27b

# Alternative Providers (NVIDIA / Google Gemini)
NVIDIA_API_KEY=YOUR_NVIDIA_API_KEY
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=google/diffusiongemma-26b-a4b-it

# Fallback / Alternative Provider: Google Gemini
OPENAI_API_KEY=YOUR_GEMINI_API_KEY
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-2.5-flash

# Conversational AI Write Flags (Disabled by default in production)
AI_ENABLE_LR_CREATION=false
AI_ENABLE_JOB_CREATION=false
AI_ENABLE_HC_CREATION=false