# PantherTMS Environment Configuration

# Application
ENVIRONMENT=development
PROJECT_NAME="PantherTMS"
API_V1_PREFIX="/api/v1"
BASE_DOMAIN="localhost"

# Security
SECRET_KEY="panther-tms-super-secret-key-change-in-production-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Settings
# Note: In docker-compose or local setup, Postgres listens on 5432 (or 5433 if local port collision)
POSTGRES_USER=panther
POSTGRES_PASSWORD=panther_secret
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
CONTROL_DB_NAME=panther_control

# Full URLs (derived automatically if not set)
CONTROL_DATABASE_URL=postgresql+asyncpg://panther:panther_secret@localhost:5433/panther_control
CONTROL_DATABASE_SYNC_URL=postgresql://panther:panther_secret@localhost:5433/panther_control

# Redis & Background Workers
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Demo Tenant Seed Info
DEMO_TENANT_ID=demo123456
DEMO_COMPANY_CODE=DEMOLOGISTICS
DEMO_TENANT_NAME="Demo Logistics Pvt Ltd"
DEMO_ADMIN_EMAIL=admin@demo.com
DEMO_ADMIN_PASSWORD=PantherTMS@2026!

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# GSP / E-Way Bill Integration (Adaequare / NIC)
GSP_BASE_URL=https://gsp.adaequare.com
GSP_CLIENT_ID=
GSP_CLIENT_SECRET=

# Freight Tiger SIM Tracking Integration (https://freight-tiger.readme.io/reference)
# Tether API: https://api.freighttiger.com/api/tether
FREIGHT_TIGER_BASE_URL=https://api.freighttiger.com/api/tether
FREIGHT_TIGER_AUTH_TOKEN=

# Razorpay Subscription & Billing
RAZORPAY_KEY_ID=rzp_test_panther_tms
RAZORPAY_KEY_SECRET=rzp_secret_panther_tms_secure
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_panther_2026

# FASTag Tracking Integration (Set in Dokploy / Coolify / .env)
FASTAG_API_URL=https://logitrack.webcorevision.com:5000/api/v1/fastag
FASTAG_API_KEY=
# Google Maps API Key for Frontend & Backend Geocoding (Falls back to Leaflet if empty)
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

