# Dedicated Staging Frontend Image for Panther AI Browser Verification
FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm install --prefer-offline --no-audit

COPY . .

# Explicitly injected at build time so Next.js inlines the staging API URL
# This guarantees client-side fetch calls NEVER point to production port 8000
ARG NEXT_PUBLIC_API_URL=http://127.0.0.1:8001
ARG NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8001
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_CPU_COUNT=1
ENV NODE_OPTIONS="--max-old-space-size=1024"
RUN npm run build

# Lightweight production runner
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"
ENV NODE_OPTIONS="--max-old-space-size=256"

COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static

EXPOSE 3000

CMD ["node", "server.js"]
